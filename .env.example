# Copy to .env and edit. Never commit .env.
# Every variable has a working default except the Gemini credentials,
# which are only needed for Live mode.

# ---- Gemini (Live mode only; the same model drives both panes) -------------
# Model ID used by the A2UI agent AND by the MCP Apps host agent loop.
# Fallback if 3.8 is not available in your project: gemini-3.6-flash
AGENT_MODEL=gemini-3.8-flash

# Option A (default): Gemini Enterprise Agent Platform on Google Cloud.
# Auth with Application Default Credentials: gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Option B: Gemini API key (Google AI Studio). Comment out option A and set:
# GOOGLE_GENAI_USE_VERTEXAI=false
# GEMINI_API_KEY=your-api-key

# ---- Open-Meteo (core/) ------------------------------------------------------
# live: real API calls (cached). fixtures: recorded responses, offline.
# Scripted mode and all tests force fixtures regardless of this value.
OPEN_METEO_MODE=live
# Response cache lifetime in seconds (be polite with the free API).
OPEN_METEO_CACHE_TTL=600
# Optional: freeze "now" (ISO 8601, UTC if no offset) for deterministic runs.
# WEATHER_FIXED_NOW=2026-10-04T12:00:00Z

# ---- Ports (local) -----------------------------------------------------------
# Standalone servers, and the Live instances used by `make compare`.
MCP_APPS_PORT=3001
A2UI_AGENT_PORT=10002
# Scripted instances used by `make compare` (fixtures, frozen clock).
SCRIPTED_MCP_APPS_PORT=3101
SCRIPTED_A2UI_AGENT_PORT=10102
# Comparison UI and its MCP Apps sandbox origin (must differ from the UI port).
COMPARE_PORT=8080
COMPARE_SANDBOX_PORT=8081

# ---- Tunnel (optional, to test the MCP Apps server in claude.ai / Claude Desktop)
# Public host name of the tunnel, e.g. abc-123.trycloudflare.com
# MCP_APPS_PUBLIC_HOST=
